# ─── Threads API (Meta Dashboard → Use Cases → Customize → Settings) ───────────
APP_ID=your_threads_specific_app_id
API_SECRET=your_threads_specific_app_secret

# ─── Local server ──────────────────────────────────────────────────────────────
HOST=threads-sample.meta
PORT=8000
DEV_MODE=false

# ─── Local HTTPS (Section 4 in readme; not used on Render/Railway) ───────────
SSL_CERT_FILE=threads-sample.meta.pem
SSL_KEY_FILE=threads-sample.meta-key.pem

# ─── Public web deployment (Render, Railway, Fly.io, VPS) ─────────────────────
# Required when NODE_ENV=production or PRODUCTION=true
PUBLIC_URL=https://your-app.example.com
SESSION_SECRET=generate_a_long_random_string_at_least_32_chars
TRUST_PROXY=true

# Optional: password visitors enter before seeing the frame (recommended)
VIEWER_PASSWORD=

# Optional: required query key for /auth in production (?key=...)
ADMIN_SETUP_KEY=

# Rate limit per IP per minute for /api/*
RATE_LIMIT_PER_MINUTE=120

# Persistent token directory (gitignored). OAuth saves encrypted token here.
DATA_DIR=data

# ─── Token (dev or hosting env vars; never commit real values) ───────────────
INITIAL_ACCESS_TOKEN=your_long_lived_token
INITIAL_USER_ID=your_numeric_threads_user_id
